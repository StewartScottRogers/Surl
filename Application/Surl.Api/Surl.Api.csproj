<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Surl.Api starts and stops Surl's protocol servers in-process for a .NET test suite
    (ADR-0098, ADR-0099). It is a product named for itself, so it carries no .UnitLibrary
    suffix (a naming exception like Surl.Console); Directory.Build.props makes it
    ahead-of-time compatible like every production project.
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="Surl.Api.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Surl.Cli.UnitLibrary\Surl.Cli.UnitLibrary.csproj" />
    <ProjectReference Include="..\Surl.Composition.UnitLibrary\Surl.Composition.UnitLibrary.csproj" />
    <ProjectReference Include="..\..\Foundation\Surl.Content.UnitLibrary\Surl.Content.UnitLibrary.csproj" />
    <ProjectReference Include="..\..\Foundation\Surl.Networking.UnitLibrary\Surl.Networking.UnitLibrary.csproj" />
    <ProjectReference Include="..\..\Foundation\Surl.Output.UnitLibrary\Surl.Output.UnitLibrary.csproj" />
    <ProjectReference Include="..\..\Foundation\Surl.Protocol.Abstractions.UnitLibrary\Surl.Protocol.Abstractions.UnitLibrary.csproj" />
  </ItemGroup>

</Project>
