<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The executable is surl, curl's server-side mate. -->
    <AssemblyName>surl</AssemblyName>
    <RootNamespace>Surl.Console</RootNamespace>
    <!--
      Native ahead-of-time is the shipping configuration and the default, so
      `dotnet publish` produces the binary that ships rather than one that only
      resembles it. `dotnet build` and `dotnet test` are unaffected - PublishAot
      only takes effect on publish.

      It needs the MSVC linker from the "Desktop development with C++" workload,
      and it needs vswhere.exe on PATH to find it. Without vswhere the link step
      fails with MSB3073 and a confusing "'vswhere.exe' is not recognized", so add
      it once per shell or machine:
          C:\Program Files (x86)\Microsoft Visual Studio\Installer
      A machine that genuinely cannot link native code opts out per publish:
          dotnet publish Surl.Console -c Release -p:PublishAot=false
      IsAotCompatible stays on for every production project and is checked by the
      VerifyAotCompatibility target in Directory.Build.props, so incompatible code
      is caught at build time rather than here.
    -->
    <PublishAot Condition=" '$(PublishAot)' == '' ">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Surl.Console.UnitTests" />
    <InternalsVisibleTo Include="Surl.Conformance.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Foundation\Surl.Authentication.UnitLibrary\Surl.Authentication.UnitLibrary.csproj" />
    <ProjectReference Include="..\Surl.Cli.UnitLibrary\Surl.Cli.UnitLibrary.csproj" />
    <ProjectReference Include="..\Surl.Composition.UnitLibrary\Surl.Composition.UnitLibrary.csproj" />
    <ProjectReference Include="..\..\Foundation\Surl.Content.UnitLibrary\Surl.Content.UnitLibrary.csproj" />
    <ProjectReference Include="..\..\Foundation\Surl.Cookies.UnitLibrary\Surl.Cookies.UnitLibrary.csproj" />
    <ProjectReference Include="..\..\Foundation\Surl.Core.UnitLibrary\Surl.Core.UnitLibrary.csproj" />
    <ProjectReference Include="..\..\Cryptography\Surl.Kerberos.UnitLibrary\Surl.Kerberos.UnitLibrary.csproj" />
    <ProjectReference Include="..\..\Foundation\Surl.Networking.UnitLibrary\Surl.Networking.UnitLibrary.csproj" />
    <ProjectReference Include="..\..\Foundation\Surl.Output.UnitLibrary\Surl.Output.UnitLibrary.csproj" />
    <ProjectReference Include="..\..\Foundation\Surl.Protocol.Abstractions.UnitLibrary\Surl.Protocol.Abstractions.UnitLibrary.csproj" />
  </ItemGroup>

</Project>
