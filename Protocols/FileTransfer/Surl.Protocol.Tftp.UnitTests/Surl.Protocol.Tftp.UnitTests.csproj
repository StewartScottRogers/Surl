<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Surl.Protocol.Tftp.UnitLibrary\Surl.Protocol.Tftp.UnitLibrary.csproj" />
  </ItemGroup>

  <!--
    Exchanges recorded from pinned upstream curl (Fixtures/README.md), embedded so a fast
    test reads them without touching the file system. Each is named Fixtures/<case>/<file>.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures\*\*" LogicalName="Fixtures/$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(FullPath)'))))/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
