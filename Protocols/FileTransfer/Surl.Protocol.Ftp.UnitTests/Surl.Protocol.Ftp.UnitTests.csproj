<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Surl.Protocol.Ftp.UnitLibrary\Surl.Protocol.Ftp.UnitLibrary.csproj" />
    <!-- FtpFaultTests match rules with the engine's own FaultPlan (segment-prefix paths), as a served instance does. -->
    <ProjectReference Include="..\..\..\Foundation\Surl.Core.UnitLibrary\Surl.Core.UnitLibrary.csproj" />
  </ItemGroup>

  <!--
    Bytes recorded from pinned upstream curl (Fixtures/README.md), embedded so a fast test
    reads them without touching the file system. Each is named Fixtures/<case>/<file>.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures\*\*" LogicalName="Fixtures/$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(FullPath)'))))/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
