<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="Surl.Http3" />
  </ItemGroup>

  <!-- The in-memory HTTP/3 test client Surl.Http3.UnitTests owns: pinned upstream curl's Initials, its own TLS 1.3 client half (BL-459). -->
  <ItemGroup>
    <Compile Include="..\Surl.Http3.UnitTests\Http3TestQuicClient.cs" Link="Http3TestQuicClient.cs" />
    <Compile Include="..\Surl.Http3.UnitTests\Http3TestResponse.cs" Link="Http3TestResponse.cs" />
    <Compile Include="..\Surl.Http3.UnitTests\IMovableClock.cs" Link="IMovableClock.cs" />
    <Compile Include="..\Surl.Http3.UnitTests\ManualTimeProvider.cs" Link="ManualTimeProvider.cs" />
    <Compile Include="..\Surl.Http3.UnitTests\UnitTestQuicClient.cs" Link="UnitTestQuicClient.cs" />
    <Compile Include="..\Surl.Http3.UnitTests\UnitTestTls13Client.cs" Link="UnitTestTls13Client.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Surl.Extended.Protocol.WebTransport.UnitLibrary\Surl.Extended.Protocol.WebTransport.UnitLibrary.csproj" />
  </ItemGroup>

  <!--
    The Initial datagrams pinned upstream curl sent, recorded once in Surl.Protocol.Http.UnitTests
    (its Fixtures/README.md says how) and embedded here too.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\Surl.Protocol.Http.UnitTests\Fixtures\h3-client-initial\static-8.21.0-win.datagrams.bin" LogicalName="Fixtures/h3-client-initial/static-8.21.0-win.datagrams.bin" />
  </ItemGroup>

</Project>
