<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="Surl.Http2" />
    <Using Include="Surl.Http3" />
    <Using Include="Surl.HttpMessage" />
    <Using Include="Surl.HttpServing" />
  </ItemGroup>

  <!-- The HTTP/2 test client Surl.Http2.UnitTests owns: client frames encoded, the server's decoded, one stream on its own. -->
  <ItemGroup>
    <Compile Include="..\Surl.Http2.UnitTests\Http2TestBytes.cs" Link="Http2TestBytes.cs" />
    <Compile Include="..\Surl.Http2.UnitTests\Http2TestClient.cs" Link="Http2TestClient.cs" />
    <Compile Include="..\Surl.Http2.UnitTests\Http2TestResponse.cs" Link="Http2TestResponse.cs" />
    <Compile Include="..\Surl.Http2.UnitTests\Http2TestStream.cs" Link="Http2TestStream.cs" />
  </ItemGroup>

  <!-- The in-memory HTTP/3 test client Surl.Http3.UnitTests owns: pinned upstream curl's Initials, its own TLS 1.3 client half. -->
  <ItemGroup>
    <Compile Include="..\Surl.Http3.UnitTests\Http3TestQuicClient.cs" Link="Http3TestQuicClient.cs" />
    <Compile Include="..\Surl.Http3.UnitTests\Http3TestResponse.cs" Link="Http3TestResponse.cs" />
    <Compile Include="..\Surl.Http3.UnitTests\UnitTestQuicClient.cs" Link="UnitTestQuicClient.cs" />
    <Compile Include="..\Surl.Http3.UnitTests\UnitTestTls13Client.cs" Link="UnitTestTls13Client.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Surl.Protocol.Http.UnitLibrary\Surl.Protocol.Http.UnitLibrary.csproj" />
  </ItemGroup>

  <!--
    Bytes recorded from pinned upstream curl (Fixtures/README.md), embedded so a fast test
    reads them without touching the file system. Each is named Fixtures/<case>/<file>.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures\*\*" LogicalName="Fixtures/$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(FullPath)'))))/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
