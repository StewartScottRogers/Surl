<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Surl.Protocol.Ldap.UnitLibrary\Surl.Protocol.Ldap.UnitLibrary.csproj" />
  </ItemGroup>

  <!--
    Bytes recorded from pinned upstream curl (Fixtures/README.md), embedded so a fast test
    reads them without touching the file system. Each is named Fixtures/<case>/<file>.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures\*\*" LogicalName="Fixtures/$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(FullPath)'))))/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Directory files in ADR-0072 decision 1's LDIF, embedded so a test writes them into an
    in-memory file system. Each is named DirectoryFiles/<file>.
  -->
  <ItemGroup>
    <EmbeddedResource Include="DirectoryFiles\*.ldif" LogicalName="DirectoryFiles/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
