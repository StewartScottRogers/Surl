<Project>
  <!--
    Central package management: every version lives here, and no PackageReference in
    a project file may carry a Version attribute (CLAUDE.md).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!--
    The one package the solution takes: Microsoft's MSTest meta-package, which carries
    the framework, the adapter and the test platform. It is what `dotnet new mstest`
    produces on SDK 10, so a test project generated by the template needs no edit to
    match this file. Nothing else is approved - see CLAUDE.md.
  -->
  <ItemGroup>
    <PackageVersion Include="MSTest" Version="4.4.1" />
  </ItemGroup>
</Project>