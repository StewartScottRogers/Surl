<Solution>

  <!--
    Surl.slnx - XML solution format (.slnx), readable and merge-friendly in a way
    the legacy .sln never was. Requires .NET SDK 9.0.200+ or Visual Studio 17.13+;
    this repo is on the SDK pinned in global.json.

    Documentation, Tasks and .claude/Claude are shared projects: they carry no build
    output, so they add nothing to build time while keeping the product and planning
    documents visible in Solution Explorer. Projects are one flat run, in ordinal
    order, with no solution folders around them (CLAUDE.md, "Project naming").
  -->

  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".gitattributes" />
    <File Path=".gitignore" />
    <File Path="CodeMetricsConfig.txt" />
    <File Path="DOWNLOAD.md" />
    <File Path="GitHub-Surl-README.url" />
    <File Path="hrdrClaudeNative.cmd" />
    <File Path="LICENSE.txt" />
    <File Path="README.md" />
    <File Path="RunClaude.cmd" />
    <File Path="UpstreamCurlBuilds.json" />
  </Folder>

  <Folder Name="/Scripts/">
    <File Path="RunClaude.cmd" />
    <File Path="hrdrClaudeNative.cmd" />
    <File Path="Measure-CodeQuality.ps1" />
    <File Path="Record-CurlExchange.ps1" />
    <File Path="RunDarkFactory.ps1" />
    <File Path="RunDarkFactory.cmd" />
    <File Path=".github/coverage/Directory.Build.props" />
    <File Path=".github/coverage/Directory.Build.targets" />
    <File Path=".github/coverage/Directory.Packages.props" />
    <File Path=".github/coverage/make-coverage-report.cs" />
    <File Path=".github/gource/Directory.Build.props" />
    <File Path=".github/gource/Directory.Build.targets" />
    <File Path=".github/gource/Directory.Packages.props" />
    <File Path=".github/gource/make-captions.cs" />
    <File Path=".github/gource/make-log.cs" />
    <File Path=".github/gource/make-master-playlist.cs" />
    <File Path=".github/gource/make-stats.cs" />
    <File Path=".github/gource/serve.cs" />
    <File Path=".github/gource/render.sh" />
    <File Path=".github/gource/site/index.html" />
    <File Path=".github/workflows/gource.yml" />
    <File Path=".github/workflows/ci.yml" />
    <File Path=".github/workflows/release.yml" />
    <File Path="install.ps1" />
    <File Path="install.sh" />
  </Folder>

  <Project Path="Surl.Authentication.UnitLibrary/Surl.Authentication.UnitLibrary.csproj" />
  <Project Path="Surl.Authentication.UnitTests/Surl.Authentication.UnitTests.csproj" />
  <Project Path="Surl.Cli.UnitLibrary/Surl.Cli.UnitLibrary.csproj" />
